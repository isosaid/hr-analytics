{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/data/hr.js",
      "destination": "/api/db"
    },
    {
      "source": "/data/hr.json",
      "destination": "/api/db"
    },
    {
      "source": "/reports/summary",
      "destination": "/api/db"
    },
    {
      "source": "/hr/data",
      "destination": "/api/db"
    },
    {
      "source": "/service/records",
      "destination": "/api/db"
    },
    {
      "source": "/status/check",
      "destination": "/api/db"
    },
    {
      "source": "/hr/state",
      "destination": "/api/db"
    },
    {
      "source": "/service/state",
      "destination": "/api/db"
    }
  ]
}